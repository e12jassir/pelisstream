<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://pelisstream.app/PelisStream"
        version="2.0.0"
        viewmodes="fullscreen">

    <tizen:application id="PelisStream.PelisStream"
                       exec="index.html"
                       screen-orientation="landscape"
                       required_version="3.0"/>

    <name>PelisStream</name>
    <description>PelisStream v2 - Catalogo y Streaming Optimizado para Smart TV</description>
    <author href="https://github.com/Alexjcs24/pelisstream">PelisStream</author>

    <icon src="icon.png"/>
    <content src="index.html"/>

    <!-- W3C Widget Access Policy: allow external providers, Cinemeta API & streaming iframes -->
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation href="*"/>

    <feature name="http://tizen.org/feature/screen.size.all"/>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"/>

    <tizen:profile name="tv"/>
</widget>
